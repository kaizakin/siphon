# Copy to .env (repo root) and fill in before running `docker compose up`.
# This .env is only read by docker-compose.yaml, separate from the per-service
# cmd/*/.env files used by `task run:*`.

POSTGRES_USER=siphon
POSTGRES_PASSWORD=siphon
POSTGRES_DB=siphon

JWT_SECRET=change-me

# smtp or resend
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
FROM_EMAIL=test@siphon.local
